<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.feenichs" name="Feenichs Add-ons" version="1.0.0" provider-name="Feenichs">
    <extension point="xbmc.addon.repository" name="Feenichs Add-ons">
        <dir>
            <info compressed="false">https://feenichs.github.io/kodi-repository/addons.xml</info>
            <checksum>https://feenichs.github.io/kodi-repository/addons.xml.md5</checksum>
            <datadir zip="true">https://feenichs.github.io/kodi-repository/</datadir>
            <hashes>sha256</hashes>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="de_DE">Add-ons von Feenichs</summary>
        <summary lang="en_GB">Add-ons by Feenichs</summary>
        <description lang="de_DE">Updates für Spotify TV, YouTube für TV, MediathekView TV und Amazon VOD TV: Forks mit einer Oberfläche für die Fernbedienung. Dazu die Module, die Amazon VOD TV braucht und die nicht im offiziellen Kodi-Repository sind.</description>
        <description lang="en_GB">Updates for Spotify TV, YouTube für TV, MediathekView TV and Amazon VOD TV: forks with an interface for remote controls. Also the modules Amazon VOD TV needs that are not in the official Kodi repository.</description>
        <platform>all</platform>
        <license>MIT</license>
        <source>https://github.com/Feenichs/kodi-repository</source>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
